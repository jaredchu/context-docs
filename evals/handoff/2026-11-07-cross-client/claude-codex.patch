+// A backup of the caller's entire active queue, not the current UI view, so it
+// takes no filter. Read-only: a missing or malformed cookie exports the empty
+// shape without creating a session or touching D1.
+async function exportItems(request, env) {
+  const session = getSession(request);
+  let items = [];
+  if (!session.isNew) {
+    const { results } = await env.DB.prepare(
+      `SELECT title, url, read FROM items
+       WHERE session_id = ?1 AND expires_at > ?2
+       ORDER BY created_at DESC, rowid DESC`,
+    )
+      .bind(session.id, nowSeconds())
+      .all();
+    items = results.map((row) => ({ title: row.title, url: row.url, read: row.read === 1 }));
+  }
+  return json({ schema_version: 1, items });
+}

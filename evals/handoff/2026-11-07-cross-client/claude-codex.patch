+test('export contains the whole active queue, read and unread, whatever the filter', async () => {
+  await withApp(async ({ newBrowser }) => {
+    const browser = newBrowser();
+    const unread = (await browser.add('Unread one', 'https://example.com/unread')).body.item;
+    const read = (await browser.add('Read one', 'https://example.com/read')).body.item;
+    assert.equal((await browser.setRead(read.id, true)).status, 200);
+    const sessionId = browser.cookie.split('=')[1];
+
+    const expected = {
+      schema_version: 1,
+      items: [
+        { title: 'Read one', url: 'https://example.com/read', read: true },
+        { title: 'Unread one', url: 'https://example.com/unread', read: false },
+      ],
+    };
+    // The UI filter is client-side; export is a backup and ignores any filter-like input.
+    for (const query of ['', '?filter=unread', '?filter=read', '?read=false']) {
+      const response = await browser.exportQueue(query);
+      assert.equal(response.status, 200, query);
+      assert.deepEqual(response.body, expected, `exact shape, no IDs or metadata (${query})`);
+      assert.equal(response.setCookie, null, 'export does not set or refresh the cookie');
+      assert.equal(response.headers.get('Cache-Control'), 'no-store');
+      assert.match(response.headers.get('Content-Type'), /^application\/json/);
+
+      const serialized = JSON.stringify(response.body);
+      for (const secret of [sessionId, unread.id, read.id]) {
+        assert.ok(!serialized.includes(secret), 'no session or database identifiers');
+      }
+    }
+  });
+});

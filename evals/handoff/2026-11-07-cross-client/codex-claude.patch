+test('export returns the versioned empty shape for missing, malformed and unknown sessions without writes', async () => {
+  await withApp(async ({ db, newBrowser }) => {
+    await newBrowser().add('Another queue', 'https://example.com/other');
+    const before = (await db.prepare('SELECT * FROM items ORDER BY rowid').all()).results;
+
+    for (const cookie of [null, 'rq_session=invalid', `rq_session=${'f'.repeat(64)}`]) {
+      const browser = newBrowser();
+      browser.cookie = cookie;
+      const response = await browser.request('GET', '/api/export', { origin: null, base: 'https://localhost' });
+      assert.equal(response.status, 200);
+      assert.deepEqual(response.body, { schema_version: 1, items: [] });
+      if (cookie === null || cookie === 'rq_session=invalid') {
+        assert.match(browser.cookie, SESSION_COOKIE_PATTERN);
+        const attributes = response.setCookie.split(';').map((part) => part.trim());
+        for (const attribute of ['HttpOnly', 'SameSite=Strict', 'Path=/', 'Max-Age=86400', 'Secure']) {

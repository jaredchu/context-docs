+// Export is a backup of the whole queue, not the current view: always fetch
+// fresh data from the API instead of serializing state.items or the filter.
+// A file is created only after a successful, well-formed response.
+async function exportQueue() {
+  hideError(exportError);
+  exportButton.disabled = true;
+  try {
+    const data = await api('GET', '/api/export');
+    if (data?.schema_version !== 1 || !Array.isArray(data.items)) {
+      throw new ApiError('The server response was not in the expected format.');
+    }
+    const backup = {
+      schema_version: 1,
+      items: data.items.map(({ title, url, read }) => ({ title, url, read })),
+    };
+    downloadJson(backup, EXPORT_FILENAME);
+    const count = backup.items.length;
+    announce(`Exported ${count} ${count === 1 ? 'link' : 'links'} to ${EXPORT_FILENAME}.`);
+  } catch (error) {
+    showError(exportError, `Export failed: ${error.message} No file was downloaded.`);
+  } finally {
+    exportButton.disabled = false;
+  }
+}

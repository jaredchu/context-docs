+async function exportItems(request, env, url) {
+  const session = getSession(request);
+  let items = [];
+  if (!session.isNew) {
+    // Export is a backup of the whole queue, including read items hidden by UI filters.
+    const { results } = await env.DB.prepare(
+      `SELECT title, url, read FROM items
+       WHERE session_id = ?1 AND expires_at > ?2
+       ORDER BY created_at DESC, rowid DESC`,
+    )
+      .bind(session.id, nowSeconds())
+      .all();
+    items = results.map((row) => ({ title: row.title, url: row.url, read: row.read === 1 }));
+  }
+
+  const response = json({ schema_version: 1, items });
+  if (session.isNew) response.headers.append('Set-Cookie', sessionCookie(session.id, url));
